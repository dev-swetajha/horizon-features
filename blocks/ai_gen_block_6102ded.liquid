{% comment %}
  Animated Product Grid Block with GSAP and static animated icons
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | replace: '-', '' | downcase %}

{% style %}
  .ai-animated-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax({{ block.settings.card_min_width }}px, 1fr));
    gap: {{ block.settings.grid_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-animated-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    transform: translateY(30px);
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .ai-animated-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow }}px {{ block.settings.hover_shadow | times: 2 }}px rgba(0, 0, 0, 0.15);
  }

  .ai-animated-card-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    margin: 0 auto {{ block.settings.image_margin }}px;
    display: block;
    object-fit: contain;
  }

  .ai-animated-card-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
    font-weight: {{ block.settings.text_weight }};
  }

  .ai-tech-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.tech_card_background }};
    color: {{ block.settings.tech_card_text_color }};
  }

  .ai-tech-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.tech_title_size }}px;
    font-weight: {{ block.settings.tech_title_weight }};
    margin: 0 0 {{ block.settings.tech_title_margin }}px 0;
    color: {{ block.settings.tech_card_text_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-animated-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
      gap: {{ block.settings.mobile_gap }}px;
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-animated-card-image-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_size }}px;
      height: {{ block.settings.mobile_image_size }}px;
    }
  }
{% endstyle %}

<animated-grid-{{ ai_gen_id }} class="ai-animated-grid-{{ ai_gen_id }} loading" {{ block.shopify_attributes }}>
  {% for i in (1..4) %}
    {% liquid
      case i
        when 1
          assign card_text = block.settings.card_1_text
          assign card_link = block.settings.card_1_link
          assign card_icon = 'booklight-icon.svg'
        when 2
          assign card_text = block.settings.card_2_text
          assign card_link = block.settings.card_2_link
          assign card_icon = 'booklight-icon.svg'
        when 3
          assign card_text = block.settings.card_3_text
          assign card_link = block.settings.card_3_link
          assign card_icon = 'booklight-icon.svg'
        when 4
          assign card_text = block.settings.card_4_text
          assign card_link = block.settings.card_4_link
      endcase
    %}

    <div class="ai-animated-card-{{ ai_gen_id }} {% if i == 4 %}ai-tech-card-{{ ai_gen_id }}{% endif %}" 
         data-card="{{ i }}" 
         data-link="{% if card_link %}{{ card_link }}{% endif %}">
      {% if i == 4 %}
        <p class="ai-tech-title-{{ ai_gen_id }}">{{ block.settings.tech_title }}</p>
        <p class="ai-animated-card-text-{{ ai_gen_id }}">{{ card_text }}</p>
      {% else %}
        <img
          src="{{ card_icon | asset_url }}"
          alt="Animated Icon"
          class="ai-animated-card-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.image_size }}"
          height="{{ block.settings.image_size }}"
        >
        <p class="ai-animated-card-text-{{ ai_gen_id }}">{{ card_text }}</p>
      {% endif %}
    </div>
  {% endfor %}
</animated-grid-{{ ai_gen_id }}>

<script>
  (function() {
    function waitForGSAP(callback) {
      if (typeof gsap !== 'undefined') {
        callback();
      } else {
        setTimeout(() => waitForGSAP(callback), 100);
      }
    }

    class AnimatedGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.hasAnimated = false;
      }

      connectedCallback() {
        waitForGSAP(() => {
          this.init();
        });
      }

      init() {
        this.setupCardClicks();
        this.setupIntersectionObserver();
        this.classList.remove('loading');

        const rect = this.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          this.animateCards();
        }
      }

      setupIntersectionObserver() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !this.hasAnimated) {
              this.animateCards();
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.2,
          rootMargin: '0px 0px -50px 0px'
        });

        observer.observe(this);
      }

      setupCardClicks() {
        const cards = this.querySelectorAll('.ai-animated-card-{{ ai_gen_id }}');
        
        cards.forEach((card) => {
          card.addEventListener('click', (e) => {
            e.preventDefault();
            const link = card.dataset.link;
            if (link && link.trim() !== '') {
              gsap.to(card, {
                scale: 0.95,
                duration: 0.1,
                yoyo: true,
                repeat: 1,
                ease: 'power2.inOut',
                onComplete: () => {
                  window.location.href = link;
                }
              });
            }
          });

          card.addEventListener('mouseenter', () => {
            gsap.to(card, {
              scale: 1.02,
              duration: 0.3,
              ease: 'power2.out'
            });
          });

          card.addEventListener('mouseleave', () => {
            gsap.to(card, {
              scale: 1,
              duration: 0.3,
              ease: 'power2.out'
            });
          });
        });
      }

      animateCards() {
        if (this.hasAnimated) return;
        this.hasAnimated = true;

        const cards = this.querySelectorAll('.ai-animated-card-{{ ai_gen_id }}');
        const images = this.querySelectorAll('.ai-animated-card-image-{{ ai_gen_id }}');

        gsap.timeline()
          .set(cards, { opacity: 0, y: 50, scale: 0.8 })
          .to(cards, {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.8,
            stagger: { amount: 0.6, from: 'start' },
            ease: 'back.out(1.2)'
          })
          .to(images, {
            rotation: 360,
            duration: 1,
            stagger: 0.1,
            ease: 'power2.inOut'
          }, '-=0.4');

        images.forEach((img, index) => {
          gsap.to(img, {
            y: -8,
            duration: 2 + (index * 0.2),
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
            delay: index * 0.3
          });
        });

        const techCard = this.querySelector('.ai-tech-card-{{ ai_gen_id }}');
        if (techCard) {
          gsap.to(techCard, {
            boxShadow: '0 0 20px rgba(255, 255, 255, 0.3)',
            duration: 2,
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut'
          });
        }
      }
    }

    if (!customElements.get('animated-grid-{{ ai_gen_id }}')) {
      customElements.define('animated-grid-{{ ai_gen_id }}', AnimatedGrid{{ ai_gen_id }});
    }
  })();
</script>

